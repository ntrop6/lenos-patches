#
# lenOS additions to the bp4a release config. LineageOS defines the same
# config name in vendor/lineage/release/release_configs/bp4a.textproto; both
# declarations are merged by the build (individual flag values must appear in
# exactly one config, which is the case here).

name: "bp4a"
aconfig_value_sets: "aconfig_value_set-lenos-bp4a"
