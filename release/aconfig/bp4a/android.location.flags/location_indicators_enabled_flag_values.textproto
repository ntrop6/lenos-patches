#
# Location privacy indicator (Tier 2 #16).
#
# AOSP's bp4a release config leaves android.location.flags
# .location_indicators_enabled disabled, so LineageOS 23.2 never shows the
# status-bar location indicator (only camera/microphone). GrapheneOS ships it
# enabled and covers coarse-only access as well
# (patches/frameworks_base/0027). READ_ONLY matches every other flag value in
# a release configuration.

flag_value {
  package: "android.location.flags"
  name: "location_indicators_enabled"
  state: ENABLED
  permission: READ_ONLY
}
