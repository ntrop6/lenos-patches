//
// lenOS aconfig value set for the bp4a release config. Every subdirectory
// holds the flag values for one aconfig package; the set collects them.
// Mirrors vendor/lineage/release/aconfig/bp4a/Android.bp.
//

aconfig_value_set {
    name: "aconfig_value_set-lenos-bp4a",
    srcs: [
        "*/Android.bp",
    ],
}
