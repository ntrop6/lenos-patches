#
# lenOS release config map.
#
# Release config names may be defined by several maps (AOSP:
# build/release/release_config_map.textproto, LineageOS:
# vendor/lineage/release/release_config_map.textproto, lenOS: this file);
# the build merges every definition of the same name, so lenOS can ship
# additional aconfig flag values for the release the platform already uses
# (vendor/lineage/vars/aosp_target_release -> bp4a) without touching AOSP or
# LineageOS files.
#
# The aconfig value set for this config lives in aconfig/bp4a/.

default_containers: "product"
default_containers: "system"
default_containers: "system_ext"
default_containers: "vendor"

release_config {
    name: "bp4a"
    flag_value_files: "release_configs/bp4a.textproto"
}
