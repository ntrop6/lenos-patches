From ff3abd51befec2dd7c317145d1a2e2d5401e7dee Mon Sep 17 00:00:00 2001
From: lenOS hardening <hardening@lenos.invalid>
Date: Sat, 29 Aug 2026 23:24:13 +0000
Subject: [PATCH] frameworks/base: trigger GC in system_server on keyguard lock
 (memory-clear-on-lock)

When the device locks, request a concurrent GC in system_server so that
freed pages holding PIN/password-derived secrets get returned to the kernel
and zeroed (the GKI base enables init-on-alloc page zeroing). Mirrors
GrapheneOS release 2024020500, which does this for both system_server and
SystemUI after locking.

This is the system_server half (KeyguardStateMonitor runs in system_server).
The SystemUI half is a separate change in packages/apps/SystemUI.

Uses VMRuntime.requestConcurrentGC() (public API, Android 12+). The
full-compacting variant GrapheneOS describes uses a hidden ART API we do not
call here; requestConcurrentGC is the safe, verifiable approximation.
---
 .../policy/keyguard/KeyguardStateMonitor.java   | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/services/core/java/com/android/server/policy/keyguard/KeyguardStateMonitor.java b/services/core/java/com/android/server/policy/keyguard/KeyguardStateMonitor.java
index c0aa8aef..c22eb19a 100644
--- a/services/core/java/com/android/server/policy/keyguard/KeyguardStateMonitor.java
+++ b/services/core/java/com/android/server/policy/keyguard/KeyguardStateMonitor.java
@@ -21,6 +21,8 @@ import android.content.Context;
 import android.os.RemoteException;
 import android.util.Slog;
 
+import dalvik.system.VMRuntime;
+
 import com.android.internal.policy.IKeyguardService;
 import com.android.internal.policy.IKeyguardStateCallback;
 import com.android.internal.widget.LockPatternUtils;
@@ -88,6 +90,21 @@ public class KeyguardStateMonitor extends IKeyguardStateCallback.Stub {
 
         mIsShowing = showing;
 
+        if (showing) {
+            // lenOS: purge sensitive data (PIN/password and derived keys) from
+            // memory when the device locks. Combined with the GKI base's
+            // init-on-alloc page zeroing, a GC here zeroes the freed pages.
+            // Mirrors GrapheneOS (release 2024020500: "run full compacting
+            // garbage collection ... in SystemUI and system_server after
+            // locking"). This is the system_server half; SystemUI needs its
+            // own trigger in packages/apps/SystemUI.
+            //
+            // requestConcurrentGC() is public API since Android 12. It requests
+            // a concurrent GC; the full-compacting variant uses a hidden ART
+            // API we deliberately do not call from here.
+            VMRuntime.getRuntime().requestConcurrentGC();
+        }
+
         mCallback.onShowingChanged();
     }
 
