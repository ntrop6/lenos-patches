From e1d03b9e1ebaf2d6e2f65e216cc83cc860302da0 Mon Sep 17 00:00:00 2001
From: lenOS hardening <hardening@lenos.invalid>
Date: Sun, 30 Aug 2026 02:31:14 +0000
Subject: [PATCH] Connectivity: enforce NETWORK permission in
 ConnectivityService

Adds hasNetworkPermission(uid) (TRAFFIC_PERMISSION_NETWORK bit) and wires it
into isNetworkWithCapabilitiesBlocked so an app lacking the NETWORK permission
is treated as having no network access.

NETWORK is default-granted (normal|instant), so this check is behavior-
preserving until a UI revokes it. Complements connectivity-0002 (bit + grant)
and bpf-0001 (inet_create enforcement).
---
 .../com/android/server/ConnectivityService.java | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/service/src/com/android/server/ConnectivityService.java b/service/src/com/android/server/ConnectivityService.java
index d1c62dc..15de07f 100644
--- a/service/src/com/android/server/ConnectivityService.java
+++ b/service/src/com/android/server/ConnectivityService.java
@@ -83,6 +83,7 @@ import static android.net.ConnectivityManager.isNetworkTypeValid;
 import static android.net.ConnectivitySettingsManager.PRIVATE_DNS_MODE_OPPORTUNISTIC;
 import static android.net.INetd.LOCAL_NET_ID;
 import static android.net.INetd.PERMISSION_INTERNET;
+import static com.android.server.connectivity.NetworkPermissions.TRAFFIC_PERMISSION_NETWORK;
 import static android.net.INetworkMonitor.NETWORK_VALIDATION_PROBE_PRIVDNS;
 import static android.net.INetworkMonitor.NETWORK_VALIDATION_RESULT_PARTIAL;
 import static android.net.INetworkMonitor.NETWORK_VALIDATION_RESULT_SKIPPED;
@@ -2989,6 +2990,17 @@ public class ConnectivityService extends IConnectivityManager.Stub
         return (mBpfNetMaps.getNetPermForUid(uid) & PERMISSION_INTERNET) != 0;
     }
 
+    /**
+     * lenOS NETWORK permission: a second, revocable layer on top of INTERNET.
+     * Uses TRAFFIC_PERMISSION_NETWORK (1 << 5), populated by PermissionMonitor
+     * from the android.permission.NETWORK grant and enforced in the BPF
+     * inet_create hook (bpf-0001). NETWORK is default-granted, so this check is
+     * behavior-preserving until a UI revokes it.
+     */
+    private boolean hasNetworkPermission(final int uid) {
+        return (mBpfNetMaps.getNetPermForUid(uid) & TRAFFIC_PERMISSION_NETWORK) != 0;
+    }
+
     /**
      * Check if UID should be blocked from using the specified network.
      */
@@ -3005,11 +3017,12 @@ public class ConnectivityService extends IConnectivityManager.Stub
             final boolean metered = nc == null ? true : nc.isMetered();
             if (mDeps.isAtLeastV()) {
                 final boolean hasInternetPermission = hasInternetPermission(uid);
+                final boolean hasNetwork = hasNetworkPermission(uid);
                 final boolean blockedByUidRules = mBpfNetMaps.isUidNetworkingBlocked(uid, metered);
                 if (mDeps.isChangeEnabled(NETWORK_BLOCKED_WITHOUT_INTERNET_PERMISSION, uid)) {
-                    return blockedByUidRules || !hasInternetPermission;
+                    return blockedByUidRules || !hasInternetPermission || !hasNetwork;
                 } else {
-                    return hasInternetPermission && blockedByUidRules;
+                    return hasInternetPermission && hasNetwork && blockedByUidRules;
                 }
             } else {
                 return mPolicyManager.isUidNetworkingBlocked(uid, metered);
-- 
