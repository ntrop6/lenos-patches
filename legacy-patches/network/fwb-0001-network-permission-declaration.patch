From f963aa34b1258324ded36f6f10b9811641ef72df Mon Sep 17 00:00:00 2001
From: lenOS hardening <hardening@lenos.invalid>
Date: Sat, 29 Aug 2026 23:24:01 +0000
Subject: [PATCH] frameworks/base: declare android.permission.NETWORK
 (revocable network access layer)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds the NETWORK permission declaration + label/description strings, modeled
on GrapheneOS. This is the FOUNDATION only: the permission declaration does
not yet enforce anything. Enforcement lives in ConnectivityService (returns
no networks / drops DNS + loopback for non-NETWORK apps) and netd (drops
sockets) — a separate, larger change in packages/modules/Connectivity.

protectionLevel normal|instant, matching INTERNET, so it is granted by
default (does not break apps) and can be revoked per-app/per-profile.
---
 core/res/AndroidManifest.xml    | 9 +++++++++
 core/res/res/values/strings.xml | 2 ++
 2 files changed, 11 insertions(+)

diff --git a/core/res/AndroidManifest.xml b/core/res/AndroidManifest.xml
index 769c3d31..80dd2faf 100644
--- a/core/res/AndroidManifest.xml
+++ b/core/res/AndroidManifest.xml
@@ -2214,6 +2214,15 @@
         android:label="@string/permlab_createNetworkSockets"
         android:protectionLevel="normal|instant" />
 
+    <!-- Allows applications to access networks. This is a second, revocable layer
+         on top of INTERNET: when denied, the app cannot use any network interface,
+         resolve DNS, or communicate over localhost (loopback). Enforcement is added
+         in ConnectivityService/netd. Protection level: normal. -->
+    <permission android:name="android.permission.NETWORK"
+        android:description="@string/permdesc_network"
+        android:label="@string/permlab_network"
+        android:protectionLevel="normal|instant" />
+
     <!-- Allows applications to access information about networks.
          <p>Protection level: normal
     -->
diff --git a/core/res/res/values/strings.xml b/core/res/res/values/strings.xml
index f9abbcd1..ee66d160 100644
--- a/core/res/res/values/strings.xml
+++ b/core/res/res/values/strings.xml
@@ -1766,6 +1766,8 @@
       connected.</string>
 
     <!-- Title of an application permission, listed so the user can choose whether they want to allow the application to do this. -->
+    <string name="permlab_network">access networks</string>
+    <string name="permdesc_network">Allows the app to access networks, including the local network. When denied, the app cannot use any network interface, resolve DNS, or communicate over localhost.</string>
     <string name="permlab_createNetworkSockets">have full network access</string>
     <!-- Description of an application permission, listed so the user can choose whether they want to allow the application to do this. -->
     <string name="permdesc_createNetworkSockets">Allows the app to create
