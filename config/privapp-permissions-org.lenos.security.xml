<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <privapp-permissions package="org.lenos.security">
        <permission name="android.permission.ACCESS_KEYGUARD_SECURE_STORAGE"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <permission name="android.permission.WRITE_SETTINGS"/>
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <!-- Wi-Fi privacy controls: WifiManager#setSendDhcpHostnameRestriction
             / querySendDhcpHostnameRestriction require NETWORK_SETTINGS. -->
        <permission name="android.permission.NETWORK_SETTINGS"/>
    </privapp-permissions>
</permissions>
