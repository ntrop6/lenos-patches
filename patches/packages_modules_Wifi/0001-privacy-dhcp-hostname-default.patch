@@ -50,6 +51,18 @@ import javax.annotation.concurrent.ThreadSafe;
 public class WifiGlobals {
 
     private static final String TAG = "WifiGlobals";
+
+    /**
+     * lenOS: Settings.Global key persisting the global DHCP hostname restriction
+     * (bitmask of {@link WifiManager#FLAG_SEND_DHCP_HOSTNAME_RESTRICTION_OPEN}
+     * and {@link WifiManager#FLAG_SEND_DHCP_HOSTNAME_RESTRICTION_SECURE}).
+     * Written by
+     * {@link WifiServiceImpl#setSendDhcpHostnameRestriction(String, int)}, read
+     * here on every service start.
+     */
+    public static final String LENOS_SETTING_SEND_DHCP_HOSTNAME_RESTRICTION =
+            "lenos_wifi_send_dhcp_hostname_restriction";
+
     private final WifiContext mContext;
     private final WifiResourceCache mWifiResourceCache;
 
@@ -100,6 +113,25 @@ public class WifiGlobals {
                 mMacRandomizationUnsupportedSsidPrefixes.add(cleanedSsid);
             }
         }
+        // lenOS: privacy-by-default DHCP hostname handling. The restriction
+        // requested through WifiServiceImpl#setSendDhcpHostnameRestriction is
+        // persisted in Settings.Global, restore it here. With no stored value,
+        // block the hostname on every network type (stock Android would send
+        // it): DHCP requests must not leak the device name to the local
+        // network. The settings provider is already up when the Wi-Fi service
+        // starts (init starts it after SettingsProvider is ready); unit tests
+        // that use a bare mock context keep the privacy default.
+        int hostnameRestriction = WifiManager.FLAG_SEND_DHCP_HOSTNAME_RESTRICTION_OPEN
+                | WifiManager.FLAG_SEND_DHCP_HOSTNAME_RESTRICTION_SECURE;
+        try {
+            hostnameRestriction = Settings.Global.getInt(mContext.getContentResolver(),
+                    LENOS_SETTING_SEND_DHCP_HOSTNAME_RESTRICTION, hostnameRestriction);
+        } catch (Exception e) {
+            Log.w(TAG, "Could not read " + LENOS_SETTING_SEND_DHCP_HOSTNAME_RESTRICTION
+                    + ", keeping the lenOS privacy default", e);
+        }
+        mSendDhcpHostnameRestriction.set(hostnameRestriction);
+
         loadCarrierSpecificEapFailureConfigMap();
     }
 
