From 468fd2939e1bc3e14ed43b535e73f5f073524ce6 Mon Sep 17 00:00:00 2001
From: lenOS hardening <hardening@lenos.invalid>
Date: Sat, 29 Aug 2026 12:35:40 +0000
Subject: [PATCH] asteroids: disable insecure enterprise Wi-Fi configuration in
 Settings/SUW

Flip config_wifiAllowInsecureEnterpriseConfigurationsForSettingsAndSUW
true -> false in both the Nothing-specific Wifi overlay and the Wifi
mainline target overlay.

This flag controls whether Settings and the Setup Wizard may create
enterprise Wi-Fi networks without a root CA and/or server domain, i.e.
without validating the server certificate. Leaving it true permits
creating MITM-able enterprise profiles. The AOSP comment explicitly
states it is 'STRONGLY RECOMMENDED to be set to false'.

Impact: users can no longer create certificate-unvalidated enterprise
networks from Settings/SUW; networks configured with proper CA/domain
validation are unaffected.
---
 rro_overlays/AsteroidsWifiOverlay/res/values/config.xml | 2 +-
 rro_overlays/WifiResTarget/res/values/config.xml        | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/rro_overlays/AsteroidsWifiOverlay/res/values/config.xml b/rro_overlays/AsteroidsWifiOverlay/res/values/config.xml
index 435cc2f..1ae212b 100644
--- a/rro_overlays/AsteroidsWifiOverlay/res/values/config.xml
+++ b/rro_overlays/AsteroidsWifiOverlay/res/values/config.xml
@@ -29,7 +29,7 @@
     <!-- Whether to allow Settings or SUW to create insecure Enterprise networks where server
          certificate is not validated, by not specifying a Root CA certificate and/or server domain
          name. It is STRONGLY RECOMMENDED to be set to false -->
-    <bool name="config_wifiAllowInsecureEnterpriseConfigurationsForSettingsAndSUW">true</bool>
+    <bool name="config_wifiAllowInsecureEnterpriseConfigurationsForSettingsAndSUW">false</bool>
 
     <!-- Indicates that bridged AP mode is supported on this device provided that
      the device interface combination allows for it -->
diff --git a/rro_overlays/WifiResTarget/res/values/config.xml b/rro_overlays/WifiResTarget/res/values/config.xml
index a94f32e..9ec045f 100644
--- a/rro_overlays/WifiResTarget/res/values/config.xml
+++ b/rro_overlays/WifiResTarget/res/values/config.xml
@@ -12,7 +12,7 @@
     <!-- Whether to allow Settings or SUW to create insecure Enterprise networks where server
          certificate is not validated, by not specifying a Root CA certificate and/or server domain
          name. It is STRONGLY RECOMMENDED to be set to false -->
-    <bool name="config_wifiAllowInsecureEnterpriseConfigurationsForSettingsAndSUW">true</bool>
+    <bool name="config_wifiAllowInsecureEnterpriseConfigurationsForSettingsAndSUW">false</bool>
 
     <!-- Indicates whether the application-centric QoS policy feature is enabled. -->
     <bool name="config_wifiApplicationCentricQosPolicyFeatureEnabled">true</bool>
