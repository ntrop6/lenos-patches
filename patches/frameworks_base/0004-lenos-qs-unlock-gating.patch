+    /**
+     * lenOS: tiles that stay usable while the device shows a secure lock
+     * screen. They neither touch radios/data nor reveal private state and
+     * remain useful in an emergency (e.g. the flashlight).
+     */
+    private static final Set<String> LENOS_LOCKED_ALLOWED_TILES =
+            Set.of(FlashlightTile.TILE_SPEC, CameraToggleTile.TILE_SPEC);
+
+    /**
+     * lenOS: every other tile action requires an unlocked device, so that a
+     * locked device cannot be used to silently toggle radios or connectivity
+     * (for example turning on airplane mode to break remote tracking/wipe).
+     */
+    private boolean requiresUnlock() {
+        if (mTileSpec != null && LENOS_LOCKED_ALLOWED_TILES.contains(mTileSpec)) {
+            return false;
+        }
+        final KeyguardManager keyguard = mContext.getSystemService(KeyguardManager.class);
+        return keyguard != null && keyguard.isDeviceSecure() && keyguard.isKeyguardLocked();
+    }
+
+    private void showUnlockRequired() {
+        Toast.makeText(mContext, R.string.lenos_qs_unlock_required, Toast.LENGTH_SHORT).show();
+    }
