+package com.android.settings.ext;
+
+import android.content.Context;
+import android.ext.settings.ExtSettings;
+
+/**
+ * lenOS: global "Secure paste" toggle. Inverted view of the GrapheneOS
+ * {@link ExtSettings#ALLOW_CLIPBOARD_READ_BY_DEFAULT} setting: checked means clipboard
+ * reads by third-party apps are restricted to content they copied themselves (and to
+ * explicit paste actions once the system paste toolbar exists). Stage 1 exposes the
+ * global default only; the per-app GrapheneOS UI is not ported yet.
+ */
+public class SecurePastePrefController extends AbstractTogglePrefController {
+    private static final String KEY = "privacy_secure_paste";
+
+    public SecurePastePrefController(Context ctx) {
+        super(ctx, KEY);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        // Device-wide setting (ExtSettings.Scope.GLOBAL), like in GrapheneOS.
+        return ExtSettingControllerHelper.getGlobalSettingAvailability(mContext);
+    }
+
+    @Override
+    public boolean isChecked() {
+        return !ExtSettings.ALLOW_CLIPBOARD_READ_BY_DEFAULT.get(mContext);
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return ExtSettings.ALLOW_CLIPBOARD_READ_BY_DEFAULT.put(mContext, !isChecked);
+    }
+}
