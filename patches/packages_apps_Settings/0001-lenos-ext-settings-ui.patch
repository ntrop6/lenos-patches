+package com.android.settings.ext;
+
+import android.content.Context;
+import android.ext.settings.IntSetting;
+import android.text.format.DateUtils;
+
+import androidx.preference.ListPreference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * lenOS: list-style control for the GrapheneOS radio auto-off timers
+ * (WIFI_AUTO_OFF / BLUETOOTH_AUTO_OFF). GrapheneOS uses a
+ * RadioButtonPickerFragment2 sub-screen through IntSettingPrefController;
+ * lenOS uses a plain ListPreference with the same choices and setting keys
+ * (documented UI substitution).
+ */
+public class AutoOffPrefController extends BasePreferenceController {
+
+    private final IntSetting setting;
+    private final String feature;
+
+    private ListPreference preference;
+
+    public AutoOffPrefController(Context ctx, String key, IntSetting setting, String feature) {
+        super(ctx, key);
+        this.setting = setting;
+        this.feature = feature;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        if (feature != null && !mContext.getPackageManager().hasSystemFeature(feature)) {
+            return UNSUPPORTED_ON_DEVICE;
+        }
+        // Device-wide (Settings.Global) setting: only the system user can edit it.
+        return ExtSettingControllerHelper.getGlobalSettingAvailability(mContext);
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        preference = screen.findPreference(getPreferenceKey());
+        if (preference == null) {
+            return;
+        }
+        preference.setPersistent(false);
+        preference.setEntries(AutoOffSetting.getEntries(mContext));
+        preference.setEntryValues(AutoOffSetting.getValues());
+        preference.setOnPreferenceChangeListener((p, newValue) -> {
+            final int value;
+            try {
+                value = Integer.parseInt((String) newValue);
+            } catch (NumberFormatException e) {
+                return false;
+            }
+            if (!setting.put(mContext, value)) {
+                return false;
+            }
+            updateState();
+            return true;
+        });
+        updateState();
+    }
+
+    private void updateState() {
+        if (preference == null) {
+            return;
+        }
+        int value = setting.get(mContext);
+        CharSequence summary = value == 0 ? mContext.getString(R.string.auto_off_never)
+                : DateUtils.formatDuration(value);
+        preference.setSummary(summary);
+        preference.setValue(Integer.toString(value));
+    }
+}
