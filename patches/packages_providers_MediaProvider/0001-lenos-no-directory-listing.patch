diff --git a/src/com/android/providers/media/StorageScopesHooks.java b/src/com/android/providers/media/StorageScopesHooks.java
new file mode 100644
index 000000000..d9a37674f
--- /dev/null
+++ b/src/com/android/providers/media/StorageScopesHooks.java
@@ -0,0 +1,161 @@
