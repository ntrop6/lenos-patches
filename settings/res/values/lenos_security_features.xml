    <string name="auto_reboot_title">Automatic BFU reboot</string>
    <string name="auto_reboot_summary">Reboot after the device remains locked for %1$s</string>
    <string name="auto_reboot_summary_off">Automatic BFU reboot is off</string>
    <string name="auto_reboot_footer">Automatically reboot after the device remains locked without a successful unlock. Rebooting returns encrypted user data to Before First Unlock state. The default is 18 hours.</string>

