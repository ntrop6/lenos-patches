    <string name="lenos_security_features_title">lenOS security</string>

    <string name="duress_pwd_pref_title">Duress PIN and password</string>
    <string name="duress_pwd_pref_summary">Configure credentials that irreversibly destroy device data when entered</string>
    <string name="duress_pwd_description">"A duress PIN or password can be entered instead of a user credential anywhere Android asks for it, including the lock screen and profile credential prompts.

Submitting either duress credential immediately deletes hardware-backed keystore secrets used to protect storage, attempts to erase installed eSIM profiles, and powers off the device. The data destruction cannot be undone. lenOS remains installed."</string>
