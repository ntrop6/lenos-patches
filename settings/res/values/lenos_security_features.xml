    <string name="duress_pwd_action_delete_confirmation">Delete the duress PIN and password?</string>
    <string name="duress_pwd_save_warning_title">Destructive credential warning</string>
    <string name="duress_pwd_save_warning_text">"Entering either duress credential instead of a normal user credential <b>will immediately and irreversibly make storage contents inaccessible</b>, attempt to erase eSIM profiles, and power off the device. Test only on expendable hardware with no important data."</string>
